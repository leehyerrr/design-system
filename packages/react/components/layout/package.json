{
  "name": "@foundation/react-components-layout",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/index.css"
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run build:js && pnpm run build:type && pnpm build:css",
    "build:js": "node build.js",
    "build:type": "tsc --emitDeclarationOnly",
    "clean": "rm -rf dist",
    "dev": "pnpm build:js --dev --watch && pnpm build:type --watch"
  },
  "devDependencies": {
    "@foundation/esbuild-config": "workspace:^",
    "@foundation/themes": "workspace:^",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/esbuild-plugin": "^2.3.22",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@foundation/themes": "workspace:^",
    "react": "^19.2.8"
  }
}
